# Deepgram configuration (required)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Agent prompt (required) - Define your AI agent's behavior
AGENT_PROMPT="You are a helpful virtual assistant. Be friendly, professional, and concise in your responses. Keep answers brief unless more detail is requested."

# Server
PORT=6033

# Audio input
DEEPGRAM_SAMPLE_RATE=8000
DEEPGRAM_INPUT_ENCODING=linear16
DEEPGRAM_INPUT_SAMPLE_RATE=8000

# Audio output
DEEPGRAM_OUTPUT_ENCODING=linear16
DEEPGRAM_OUTPUT_SAMPLE_RATE=8000
DEEPGRAM_OUTPUT_CONTAINER=none

# Agent language
DEEPGRAM_LANGUAGE=en

# Listen (STT) provider
DEEPGRAM_LISTEN_PROVIDER=deepgram
DEEPGRAM_ASR_MODEL=nova-3

# Think (LLM) provider
DEEPGRAM_THINK_PROVIDER=open_ai
DEEPGRAM_THINK_MODEL=gpt-4o-mini

# Speak (TTS) provider
DEEPGRAM_SPEAK_PROVIDER=deepgram
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Greeting message
DEEPGRAM_GREETING="Hi there, I'm your virtual assistant—how can I help today?"

# Keep-alive interval in milliseconds
DEEPGRAM_KEEPALIVE_INTERVAL=5000

# AMI URL for call control tools (avr_transfer, avr_hangup)
AMI_URL=http://127.0.0.1:6006
